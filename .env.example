# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Teacher admin password for /admin portal (server-side only).
ADMIN_PASSWORD="CHANGE_ME_TEACHER_PASSWORD"

# SESSION_SECRET: Secret key for signing teacher admin session tokens.
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"

# Optional Supabase configuration for external cloud deployment
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
